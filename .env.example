# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN DREAM HOUSE (MẪU TEMPLATE)
# Sao chép file này thành .env và điền các khóa tương ứng cho dự án Supabase của bạn.
# Lưu ý: File .env thật chứa thông tin của bạn được .gitignore bảo vệ tuyệt đối và không bao giờ bị push lên GitHub.

# 1. Supabase Project URL & Publishable / Anon Key (Lấy từ Supabase Dashboard > Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Thông tin liên hệ hỗ trợ
CONTACT_PHONE=0900000000
CONTACT_ZALO=https://zalo.me/0900000000
CONTACT_EMAIL=contact@yourdomain.com
CONTACT_FACEBOOK=https://www.facebook.com/yourpage

# 3. Cấu hình cổng máy chủ chạy local
PORT=3000


